{
  "name": "types-mediawiki-response",
  "version": "1.1.0",
  "description": "TypeScript type definitions for MediaWiki Action API responses",
  "keywords": [
    "action-api",
    "api-response",
    "mediawiki",
    "types",
    "typescript",
    "wiki"
  ],
  "homepage": "https://bearbin1215.github.io/types-mediawiki-response/",
  "bugs": {
    "url": "https://github.com/BearBin1215/types-mediawiki-response/issues"
  },
  "license": "MIT",
  "author": "BearBin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BearBin1215/types-mediawiki-response.git"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh.md"
  ],
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts"
    },
    "./ext/*": {
      "types": "./dist/extensions/*.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "pnpm run typecheck",
    "audit:literals": "tsx scripts/audit-literals.ts",
    "audit:paraminfo": "tsx scripts/audit-paraminfo.ts",
    "check": "pnpm run format:check && pnpm run lint && pnpm run test && pnpm run audit:literals && pnpm run audit:paraminfo && pnpm run check:ext && pnpm run check:pack && pnpm run check:examples",
    "prepublishOnly": "pnpm run build",
    "fetch:fixtures": "tsx scripts/fetch-fixtures.ts",
    "fetch:paraminfo": "tsx scripts/fetch-paraminfo.ts",
    "check:ext": "tsx scripts/check-ext-consumer.ts",
    "check:examples": "pnpm run build && pnpm --filter ./examples/* run typecheck",
    "check:pack": "pnpm run build && attw --pack .",
    "release": "pnpm run check && bumpp",
    "release-notes": "tsx scripts/generate-release-notes.ts",
    "docs:dev": "pnpm --filter types-mediawiki-response-docs dev",
    "docs:build": "pnpm --filter types-mediawiki-response-docs build",
    "docs:preview": "pnpm --filter types-mediawiki-response-docs preview"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/node": "^26.6.3",
    "bumpp": "^12.3.0",
    "expect-type": "1.4.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.34.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
